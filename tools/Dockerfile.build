# Linux build/test environment for the QEMU development images (x86_64).
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pil python3-pip python3-cryptography djvulibre-bin libarchive-tools busybox-static squashfs-tools cpio e2fsprogs \
    qemu-system-x86 linux-image-virtual git ca-certificates && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir --break-system-packages PyMuPDF pyphen
WORKDIR /rossini
