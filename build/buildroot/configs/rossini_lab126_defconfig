# Rossini OS, ARMv7 (Cortex-A9) QEMU vexpress target. Cross-compiled userland for the ARM architecture class of
# older Kindles; NOT a Kindle image (different SoC, display, storage, boot).
BR2_arm=y
BR2_ARM_ENABLE_NEON=y
BR2_ARM_ENABLE_VFP=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PY_ONLY=y
BR2_PACKAGE_PYTHON3_SQLITE=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_PYTHON3_XZ=y
BR2_PACKAGE_PYTHON3_BZIP2=y
BR2_PACKAGE_PYTHON_PILLOW=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_PYTHON_PYMUPDF=y
BR2_PACKAGE_PYTHON_PYPHEN=y
BR2_PACKAGE_LIBARCHIVE=y
BR2_PACKAGE_LIBARCHIVE_BSDTAR=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_FSCK=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_TARGET_ROOTFS_TAR=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_cortex_a9=y
# Userland for the Lab126 3.0.35 kernel: musl enforces no minimum kernel version (glibc >= 2.39 requires 3.2+ and
# aborts with "kernel too old" on 3.0.35). Headers are newer than the runtime kernel; musl falls back on ENOSYS.
BR2_TOOLCHAIN_BUILDROOT=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_KERNEL_HEADERS_5_4=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="400M"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ROSSINI_PATH)/board/lab126/post-build.sh"
BR2_TARGET_GENERIC_GETTY_PORT="ttymxc0"
